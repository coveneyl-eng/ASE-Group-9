# Copy to .env. Everything is optional: without keys the slice uses fixtures and dry-run providers.
# OFFLINE=1                       # force fixtures instead of calling the APIs/ clients
# TICKETMASTER_API_KEY=           # APIs/ticketmasterAPI.py
# TOMTOM_API_KEY=                 # APIs/trafficCongestionAPI.py
# SMSAPI_TOKEN=                   # APIs/notification/SMSapi.py (test mode: validated, not delivered)
# SMS_LIVE=1                      # actually deliver SMS
# NOTIFY_SMS_TO=+3538xxxxxxx
# GMAIL_CLIENT_SECRET_FILE=/certs/client_secret.json   # APIs/notification/Emailapi.py
# GMAIL_TOKEN_FILE=/certs/token.json                   # made once by running Emailapi locally
# NOTIFY_EMAIL_TO=you@tcd.ie
