{
 "title": "Smart City thin slice",
 "uid": "smartcity-thin-slice",
 "schemaVersion": 39,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "5s",
 "panels": [
  {
   "title": "Sensor-to-alert latency p95 (target <= 5 s)",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(smartcity_sensor_to_alert_seconds_bucket[5m])))",
     "refId": "A"
    }
   ]
  },
  {
   "title": "Decisions per agent",
   "type": "barchart",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (agent) (smartcity_messages_processed_total)",
     "refId": "A",
     "instant": true,
     "format": "table"
    }
   ]
  },
  {
   "title": "Messages bridged/ingested",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (job, instance) (rate(smartcity_messages_processed_total[1m]))",
     "refId": "A"
    }
   ]
  }
 ]
}